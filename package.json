  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "npm run smui-theme-light && npm run smui-theme-dark",
    "smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
    "smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
    "test": "node scripts/test/run.mjs",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.3",
    "contentful": "^11.12.10",
    "contentful-management": "^12.19.3",
    "fast-xml-parser": "^5.11.2",
    "fuzzyjs": "^5.0.1"
  },
  "devDependencies": {
    "@smui/button": "^9.0.6",
    "@smui/data-table": "^9.0.6",
    "@smui/dialog": "^9.0.6",
    "@smui/drawer": "^9.0.6",
    "@smui/icon-button": "^9.0.6",
    "@smui/linear-progress": "^9.0.6",
    "@smui/list": "^9.0.6",
    "@smui/paper": "^9.0.6",
    "@smui/tab": "^9.0.6",
    "@smui/tab-bar": "^9.0.6",
    "@smui/textfield": "^9.0.6",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "sass": "^1.106.1",
    "smui-theme": "^9.0.6",
    "svelte": "^5.57.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/analytics": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
