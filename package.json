  "engines": {
    "node": "24.x",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build-docker": "DOCKER_BUILD=true vite build --verbose",
    "docker-build": "docker build . -t $USER/league-page:latest",
    "docker-run": "npm run docker-build && docker run -p 3000:3000 $USER/league-page:latest",
    "preview": "vite preview",
    "prepare": "npm run smui-theme-light && npm run smui-theme-dark",
    "smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
    "smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
    "lint": "prettier --check --plugin-search-dir=. . && eslint --ignore-path .gitignore .",
    "format": "prettier --write --plugin-search-dir=. .",
    "test": "node scripts/test/run.mjs",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "contentful": "^11.12.10",
    "contentful-management": "^12.19.0",
    "fast-xml-parser": "^5.11.2",
    "fuzzyjs": "^5.0.1"
  },
  "devDependencies": {
    "@smui/button": "^8.0.3",
    "@smui/data-table": "^8.0.3",
    "@smui/dialog": "^8.0.3",
    "@smui/drawer": "^8.0.3",
    "@smui/icon-button": "^8.0.3",
    "@smui/linear-progress": "^8.0.3",
    "@smui/list": "^8.0.3",
    "@smui/paper": "^8.0.3",
    "@smui/tab": "^8.0.3",
    "@smui/tab-bar": "^8.0.3",
    "@smui/textfield": "^8.0.3",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.93.2",
    "smui-theme": "^8.0.3",
    "svelte": "^5.57.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
